# Set in Render Environment or local .env. Never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full
DISCORD_CLIENT_ID=your_discord_application_client_id
DISCORD_CLIENT_SECRET=your_discord_application_client_secret
SESSION_SECRET=generate_a_long_random_secret_string
# Optional: override automatic callback URL (defaults to http(s)://<host>/api/auth/discord/callback)
# DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback
